# Meridian's site for the server's Caddy. Copy to /etc/caddy-sites/ on the server (see deploy/README.md).
meridian.sendwise.online {
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Robots-Tag "noindex, nofollow"  # a private team tool: keep it out of search results
		-Server
	}
	# Cloudflare sits in front, so the visitor's own address is in CF-Connecting-IP, not in the connection.
	# Meridian counts wrong passwords per address; without this every visitor would share Cloudflare's.
	reverse_proxy meridian:8321 {
		header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
	}
}
